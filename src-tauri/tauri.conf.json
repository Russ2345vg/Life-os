{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LifeOS",
  "version": "../package.json",
  "identifier": "com.lifeos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LifeOS",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "transparent": false,
        "incognito": false,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "capabilities": ["desktop", "android"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDOEJGNDk2RTU2MEFENQpSV1RWQ2xadVNiL0lDVjJUL2VyQmpkM2Uxbjh2Nm56QnVBcFY4dkU4M3AwREpuc3BMK09xdzE2aQo=",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
